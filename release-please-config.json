{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-v-in-tag": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "pull-request-header": "WHAT\n\nPrepare the next Autoclick release.\n\nWHY\n\nKeep release notes and release metadata current before publishing immutable release assets.\n\nHOW",
  "packages": {
    ".": {
      "package-name": "Autoclick",
      "release-type": "simple",
      "prerelease": true,
      "prerelease-type": "beta",
      "extra-files": [
        {
          "type": "generic",
          "path": "Autoclick/Version.xcconfig"
        }
      ]
    }
  }
}
